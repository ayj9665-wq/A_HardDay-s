{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A Hard Day's",
  "version": "0.1.0",
  "identifier": "com.aharddays.clock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "A Hard Day's",
        "width": 760,
        "height": 900,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A task-focused desktop clock"
  }
}
